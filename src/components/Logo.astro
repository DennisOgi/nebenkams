---
import { Image } from 'astro:assets';
import logo from '../assets/brand/Beauberyl Logo 2.png';
interface Props {
  class?: string;
  loading?: 'eager' | 'lazy';
  id?: string;
}
const { class: className, loading = 'eager', id } = Astro.props;
---

<Image
  src={logo}
  alt="Beuberyl Tarpaulin Ltd"
  class={className}
  id={id}
  loading={loading}
  decoding="async"
  format="png"
/>
