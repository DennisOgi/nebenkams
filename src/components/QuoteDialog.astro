---
import Field from './Field.astro';
import Icon from './Icon.astro';
import { budgetOptions, services } from '../data/site';
const serviceOptions = services.map((s) => ({ value: s.quoteId, label: s.name }));
---

<dialog class="quote-dialog" id="quote-dialog" aria-labelledby="quote-title">
  <div class="qd-head">
    <h2 id="quote-title">Tell us about your new project</h2>
    <button class="qd-close" type="button" data-quote-close aria-label="Close quote form">
      <Icon name="close" />
    </button>
  </div>
  <div class="qd-body">
    <form class="form-grid form-grid--pair" data-form="quote" data-endpoint="/home/ajax/quote" novalidate id="quote-form" enctype="multipart/form-data">
      <Field
        id="q-service"
        name="service_id"
        label="Service"
        type="select"
        required
        selectPrompt="Select a service"
        options={serviceOptions}
        requiredMessage="Choose a service."
      />
      <Field
        id="q-budget"
        name="budget"
        label="Project budget"
        type="select"
        required
        selectPrompt="Select a project budget"
        options={budgetOptions}
        requiredMessage="Choose a project budget."
      />
      <Field id="q-name" name="name" label="Full name" required autocomplete="name" />
      <Field id="q-email" name="email" label="Email address" type="email" required autocomplete="email" />
      <Field id="q-tel" name="tel" label="Phone number" type="tel" required autocomplete="tel" span2 />
      <Field id="q-desc" name="description" label="Project description" type="textarea" span2 />
      <Field
        id="q-start"
        name="start_when"
        label="Desired start timing"
        hint="Tell us how soon you want this project started."
        span2
      />
      <div class="field span-2" data-file-field>
        <span class="label" id="q-file-label">Attach a file <span class="req">(optional)</span></span>
        <p class="hint" id="q-file-hint">PDF or Word document (.pdf, .doc, .docx).</p>
        <div class="file-drop" data-file-drop>
          <Icon name="paperclip" />
          <span><span class="file-cta">Choose a file</span></span>
          <input
            type="file"
            id="q-file"
            name="attachment"
            accept="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.pdf,.doc,.docx"
            aria-labelledby="q-file-label"
            aria-describedby="q-file-hint"
          />
        </div>
        <div class="file-chosen" data-file-chosen hidden>
          <span class="name" data-file-name></span>
          <button type="button" data-file-remove>Remove <span class="sr-only">attached file</span></button>
        </div>
        <p class="field-error" id="q-file-error" hidden></p>
      </div>
      <div class="span-2 form-status" aria-live="polite"></div>
      <div class="span-2 form-actions">
        <button class="btn btn--primary btn--block" type="submit" data-label="Send quote request">Send quote request</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { initQuoteDialog } from '../scripts/quote';
  initQuoteDialog();
</script>
