---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CallbackForm from '../components/CallbackForm.astro';
import ContactList from '../components/ContactList.astro';
import { contact } from '../data/site';
---

<Base title="Contact Us" description="Call, email or write to Beuberyl Tarpaulin Ltd. Office in Amuwo Odofin, branch in Mushin, factory in Festac.">
  <PageHead title="Contact Us" lede="How can we help" />

  <section class="section callback on-dark" data-reveal>
    <div class="wrap contact-board">
      <div class="contact-intro">
        <p class="eyebrow">Support</p>
        <p class="callback-lead">Call or email us, or send a message and we will get back to you.</p>
        <p class="contact-person">{contact.person.name} <span>{contact.person.role}</span></p>
      </div>
      <ContactList includeHours includeAddress />
      <div class="form-surface">
        <h3>Send a message</h3>
        <CallbackForm id="contact-form" />
      </div>
    </div>
  </section>
</Base>
