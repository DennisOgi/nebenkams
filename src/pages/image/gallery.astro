---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { gallery, GALLERY_PAGE_SIZE } from '../../data/site';

const requested = Number(Astro.url.searchParams.get('page') ?? '1');
const totalPages = Math.max(1, Math.ceil(gallery.length / GALLERY_PAGE_SIZE));
const page = Number.isFinite(requested) ? Math.min(Math.max(1, requested), totalPages) : 1;
const start = (page - 1) * GALLERY_PAGE_SIZE;
const items = gallery.slice(start, start + GALLERY_PAGE_SIZE);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<Base title="Gallery" description="Photographs of Nebenkams tarpaulin work, grouped by the service labels used on the live site.">
  <PageHead title="Project Gallery" lede="From the Gallery" />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Past Projects</p>
      <ul class="gallery-grid">
        {
          items.map((item, i) => (
            <li>
              <figure class="g-item">
                <button
                  class="g-thumb"
                  type="button"
                  data-gallery-open
                  data-full={item.src.src}
                  data-alt={item.caption}
                  data-caption={item.caption}
                  aria-label={`Open ${item.caption} image ${start + i + 1}`}
                >
                  <Image src={item.src} alt="" widths={[400, 720, 1100]} sizes="(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 50vw" loading={i < 4 ? 'eager' : 'lazy'} />
                </button>
                <figcaption>{item.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      {
        totalPages > 1 && (
          <nav aria-label="Gallery pages">
            <ol class="pagination">
              {pages.map((n) => (
                <li>
                  <a href={n === 1 ? '/image/gallery' : `/image/gallery?page=${n}`} aria-current={n === page ? 'page' : undefined}>
                    {n}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Gallery image">
    <div class="lb-top">
      <p data-lb-count></p>
      <button class="lb-btn" type="button" data-lb-close aria-label="Close">
        <Icon name="close" />
      </button>
    </div>
    <div class="lb-stage">
      <img data-lb-img alt="" />
    </div>
    <div class="lb-bottom">
      <button class="lb-btn" type="button" data-lb-prev aria-label="Previous image">
        <Icon name="arrow-left" />
      </button>
      <p data-lb-caption></p>
      <button class="lb-btn" type="button" data-lb-next aria-label="Next image">
        <Icon name="arrow-right" />
      </button>
    </div>
  </dialog>
</Base>

<script>
  import { initGallery } from '../../scripts/gallery';
  initGallery();
</script>
